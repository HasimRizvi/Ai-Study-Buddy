# Normalise line endings so the repository behaves consistently
# across Windows, macOS and Linux (and on the Render build agents).
* text=auto eol=lf

*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.png  binary
*.jpg  binary
*.svg  text eol=lf
*.ico  binary
