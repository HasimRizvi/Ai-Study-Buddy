# ==========================================================
#  AI StudyBuddy - Environment Configuration
#  Copy this file to  server/.env  and fill in the values.
# ==========================================================

# Server port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas free cluster)
# Local fallback: mongodb://127.0.0.1:27017/ai-study-buddy
MONGO_URI=your_mongodb_connection_string

# Secret key used to sign JWT tokens
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Google Gemini API key (optional)
# Get a free key at https://aistudio.google.com/apikey
# If this is left blank the app automatically uses the built-in
# Offline Demo Engine, so every feature still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# File upload limits
MAX_FILE_SIZE_MB=5
